[Unit]
Description=CPU reranker for vault search (Qwen3-Reranker-0.6B on CPU)

[Service]
ExecStart=%h/.local/bin/llama-server -m %h/models/qwen3-reranker-0.6b-q8_0.gguf --reranking --pooling rank --n-gpu-layers 0 --threads 6 --ctx-size 16384 --batch-size 2048 --ubatch-size 2048 -np 8 --host 127.0.0.1 --port 8095
Restart=on-failure
Nice=10

[Install]
WantedBy=default.target
